<div class="main-banner" id="top">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6">
                <div class="left-content">
                    <div class="thumb">
                        <div class="inner-content">
                            <h4>{{ presentation_categories[0].name }}</h4>
                            <span id="main-description">{{ presentation_categories[0].description | raw}}</span>
                            <div class="main-border-button">
                                <a href="{{ path('products', {categoryId: presentation_categories[0].id}) }}">Acheter !</a>
                            </div>
                        </div>
                        <img src="{{ vich_uploader_asset(presentation_categories[0], 'imageFile') }}" alt="{{ presentation_categories[0].imageName }}">
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="right-content">
                    <div class="row">
                        {% for category in presentation_categories %}
                        {% if loop.index != 1 %}
                        <div class="col-lg-6">
                            <div class="category">
                                <div class="thumb">
                                    <div class="inner-content">
                                        <h4>{{ category.name }}</h4>
                                    </div>
                                    <div class="hover-content">
                                        <div class="inner">
                                            <h4>{{ category.name }}</h4>
                                            <div class="category-description">
                                                {{ category.description | raw}}
                                            </div>
                                            <div class="main-border-button">
                                                <a href="{{ path('products', {categoryId: category.id}) }}">Découvrir plus</a>
                                            </div>
                                        </div>
                                    </div>
                                    <img src="{{ vich_uploader_asset(category, 'imageFile') }}" alt="{{ category.imageName }}">
                                </div>
                            </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>